msgid "Address for Tailscale's outbound HTTP proxy listener; leave empty to disable."
msgstr "Tailscale 出站 HTTP 代理监听地址；留空禁用。"

msgid "Adjust TCP maximum segment size to reduce path-MTU problems across the tunnel."
msgstr "调整 TCP 最大报文段长度，以减少隧道传输中的路径 MTU 问题。"

msgid "Advertise as exit node"
msgstr "宣告为出口节点"

msgid "Advertise LAN subnets connected to this router. Remote devices also need to accept subnet routes, and each route may need admin approval."
msgstr "发布连接到本路由器的 LAN 子网。远端设备也必须启用接收子网路由，且每条路由可能需要管理员批准。"

msgid "Advertise subnet routes"
msgstr "宣告子网路由"

msgid "Advertise this device as an internet exit node for other tailnet devices. Approval may be required in the admin console."
msgstr "将本设备发布为其他 Tailnet 设备的互联网出口节点；可能还需在管理控制台批准。"

msgid "All"
msgstr "全部"

msgid "All N nodes shown"
msgstr "共 N 台，全部显示"

msgid "Allow devices on this router's LAN to initiate connections to tailnet peers."
msgstr "允许本路由器 LAN 内的设备主动连接 Tailnet 节点。"

msgid "Allow forwarding from the WAN toward Tailscale. This increases exposure and should only be enabled with an explicit firewall policy."
msgstr "允许从 WAN 向 Tailscale 转发流量，会增加暴露风险；仅应在明确配置防火墙策略后启用。"

msgid "Allow LAN bypass on exit node"
msgstr "出口节点允许 LAN 直连"

msgid "Allow tailnet devices to forward internet-bound traffic through this router."
msgstr "允许 Tailnet 设备经本路由器转发互联网流量。"

msgid "Allow tailnet devices to initiate connections to devices on this router's LAN."
msgstr "允许 Tailnet 设备主动连接本路由器 LAN 内的设备。"

msgid "Allow tailnet peers to connect to this device using Tailscale SSH, subject to the tailnet access policy."
msgstr "允许 Tailnet 节点通过 Tailscale SSH 连接本设备，实际访问仍受 Tailnet 访问策略限制。"

msgid "Allow this device to install subnet routes advertised by other tailnet nodes. The routes must also be approved by an administrator."
msgstr "允许本设备安装 Tailnet 其他节点发布的子网路由；路由还必须由管理员在管理控制台批准。"

msgid "Allow this local account to control Tailscale without sudo."
msgstr "允许此本地账户不使用 sudo 管理 Tailscale。"

msgid "Applied"
msgstr "已应用"

msgid "Applied, service restarting"
msgstr "已应用，服务重启中"

msgid "Apply failed"
msgstr "应用失败"

msgid "Apply source NAT to traffic forwarded to advertised subnets, so destination LAN devices see the router as the source."
msgstr "对转发到已发布子网的流量执行源地址转换，使目标 LAN 设备看到的来源为本路由器。"

