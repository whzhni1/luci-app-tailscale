config main 'main'
	option enabled '0'
	option bin_dir '/usr/sbin'
	option state_dir '/etc/tailscale'
	option socket '/var/run/tailscale/tailscaled.sock'
	option tun 'tailscale0'
	option port '0'
	option socks5 ''
	option http_proxy ''
	option start_delay '0'
	option respawn_threshold '3600'
	option respawn_timeout '5'
	option respawn_retry '5'
	option mode 'tun'
	option log_enabled '1'
	option log_limit_kb '300'
	option log_errors_only '0'
	option theme 'auto'
	option tmp_dir '/tmp/tailscale'
	option derp_preferred_region '0'

config up 'up'
	option hostname ''
	option auth_key ''
	option accept_dns '0'
	option accept_routes '0'
	option advertise_routes ''
	option advertise_exit_node '0'
	option exit_node ''
	option exit_node_allow_lan '0'
	option shields_up '0'
	option snat_subnet_routes '1'
	option ssh '0'
	option operator ''
	option login_server ''
	option netfilter_mode 'on'
	option stateful_filtering '0'

config network 'network'
	option iface_enabled '1'
	option iface_name 'tailscale'
	option zone_enabled '1'
	option zone_name 'tailscale'
	option masq '1'
	option mss '1'
	option fwd_ts_lan '1'
	option fwd_lan_ts '1'
	option fwd_ts_wan '0'
	option fwd_wan_ts '0'
	option conflicts 'overwrite'
	option reload_network_on_stop '1'

config update 'update'
	option channel 'custom'
	option source_order 'gitlab github r2'
	option arch 'auto'
	option version 'latest'
	option file 'auto'
	option auto_update '0'
	option auto_rollback '1'
	option service_wait_seconds '180'
	option every_days '7'
	option at_time '03:30'
	option keep_backup '1'
	option timeout '20'
	option retry '2'
	option cache_ttl '3600'
	option dl_timeout '600'
	option jitter '600'
