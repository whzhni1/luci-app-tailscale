	let boolOps = [['accept_dns', '--accept-dns'], ['accept_routes', '--accept-routes'], ['advertise_exit_node', '--advertise-exit-node'], ['exit_node_allow_lan', '--exit-node-allow-lan-access'], ['shields_up', '--shields-up'], ['snat_subnet_routes', '--snat-subnet-routes'], ['ssh', '--ssh'], ['stateful_filtering', '--stateful-filtering']];
