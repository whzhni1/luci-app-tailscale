function loginUrlCandidate(token) {
	token = trim('' + (token || ''));
	while (length(token) > 0 && index('.,;:!?)]}', substr(token, length(token) - 1, 1)) >= 0)
		token = substr(token, 0, length(token) - 1);
	if (substr(token, 0, 8) != 'https://' && substr(token, 0, 7) != 'http://')
		return '';
	if (index(token, 'tailscale.com/s/') >= 0)
		return '';
	return token;
}

function extractLoginUrl(text) {
	text = '' + (text || '');
	let lines = split(text, '\n');
	let authContext = 0;
	for (let line in lines) {
		if (index(line, 'authenticate') >= 0 || index(line, 'authentication') >= 0 || index(line, 'login URL') >= 0 || index(line, 'login link') >= 0)
			authContext = 3;
		let tokens = split(replace(line, /[\t\r]+/g, ' '), ' ');
		for (let token in tokens) {
			let candidate = loginUrlCandidate(token);
			if (candidate != '' && authContext > 0)
				return candidate;
		}
		if (authContext > 0)
			authContext--;
	}
	for (let line in lines) {
		for (let token in split(replace(line, /[\t\r]+/g, ' '), ' ')) {
			let candidate = loginUrlCandidate(token);
			if (candidate == '')
				continue;
			if (index(candidate, 'login.tailscale.com/a/') >= 0)
				return candidate;
			let loginServer = cfg('up', 'login_server', '');
			if (loginServer != '' && substr(candidate, 0, length(loginServer)) == loginServer)
				return candidate;
		}
	}
	return '';
}

function upWaitSocket() {
	for (let i = 0; i <= SOCKET_WAITS; i++) {
		if (sh('test -S ' + sq(sockpath()) + ' 2>/dev/null').rc == 0)
