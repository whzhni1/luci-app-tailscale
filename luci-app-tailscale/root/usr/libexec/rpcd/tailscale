	for (let i = 0; i < length(pid); i++) {
		if (index('0123456789', substr(pid, i, 1)) < 0) return false;
	}
	return sh('kill -0 ' + pid + ' 2>/dev/null').rc == 0;
}

function upCurrentOutput(td) {
	let log = null;
	try { log = readfile(td + '/up-url.log'); } catch (e) { log = null; }
