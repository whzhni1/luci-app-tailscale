		return { ok: false, error: 'reauth_spawn' };
	}
	let output = upCurrentOutput(td);
	let url = extractLoginUrl(output);
	if (url != '') {
		logTailscale(cmd, 'url', output);
		return { ok: true, url: url };
	}
	let statusCmd = sq(bindir() + '/tailscale') + ' --socket=' + sq(sockpath()) + ' status 2>&1';
	let status = sh(statusCmd);
	url = extractLoginUrl(status.out);
	if (url != '') {
		logTailscale(statusCmd, status.rc, status.out);
		return { ok: true, url: url };
	}
	output = upCurrentOutput(td);
	url = extractLoginUrl(output);
	if (url != '') {
		logTailscale(cmd, 'url', output);
		return { ok: true, url: url };
	}
	if (upPidAlive(td))
		return { ok: true, pending: true };
