function descendants(pid) {
	let out = [];
	let seen = {};
	let work = [pid];
	seen[pid] = true;
	for (let i = 0; i < length(work); i++) {
		let files = null;
		try { files = glob('/proc/' + work[i] + '/task/*/children'); } catch (e) { files = null; }
		if (files == null) continue;
		for (let f in files) {
			let txt = null;
			try { txt = readfile(f); } catch (e) { txt = null; }
			if (txt == null) continue;
			for (let c in filter(split(trim(txt), ' '), (x) => x != '')) {
				if (seen[c] == true) continue;
				seen[c] = true;
				work[length(work)] = c;
				out[length(out)] = c;
			}
		}
	}
	return out;
}
function cancelTask(p) {
	let id = clean_id(p.task_id);
	if (id == null) return { ok: false, error: 'bad_task' };
	let td = tmpdir();
	let manualOwner = '';
	try { manualOwner = trim(readfile(manual_upload_lock() + '/id')); } catch (e) {}
	if (manualOwner == id) {
		let manualStatus = jread(td + '/task-' + id + '.json');
		if (manualStatus != null && manualStatus.step != 'upload') return { ok: false, error: 'cancel_too_late' };
	}
	let pid = null;
	try { pid = readfile(td + '/task-' + id + '.pid'); } catch (e) { pid = null; }
	if (pid != null) {
		pid = trim(pid);
		let ok = (pid != '');
		for (let i = 0; i < length(pid); i++) {
			if (index('0123456789', substr(pid, i, 1)) < 0) ok = false;
		}
		if (ok) {
			let tree = descendants(pid);
			tree[length(tree)] = pid;
			for (let p in tree) sh('kill ' + p + ' 2>/dev/null');
			for (let i = 0; i < 20; i++) {
				let alive = false;
				for (let p in tree) {
					if (sh('kill -0 ' + p + ' 2>/dev/null').rc == 0) alive = true;
				}
				if (!alive) break;
				sh('sleep 0.1');
			}
			for (let p in tree) sh('kill -9 ' + p + ' 2>/dev/null');
		}
		try { unlink(td + '/task-' + id + '.pid'); } catch (e) {}
	}
	if (manualOwner == id) manual_upload_clear(id);
	try {
		writefile(td + '/task-' + id + '.json', '{"step":"cancelled","percent":0,"msg":"","done":true,"error":"cancelled"}');
	} catch (e) {
		return { ok: false, error: 'mark_fail' };
	}
	return { ok: true };
}

function op_lock_alive(lock) {
	let pid = '', cmd = null;
	try { pid = trim(readfile(lock + '/pid')); } catch (e) { pid = ''; }
	if (pid == null || pid == '') {
		let st = stat(lock);
		return st != null && time() - st.mtime <= 10;
	}
	try { cmd = readfile('/proc/' + pid + '/cmdline'); } catch (e) { cmd = null; }
	return cmd != null && index(cmd, lock) >= 0;
}

function op_lock_release(lock) {
	sh('rm -f ' + sq(lock + '/pid') + '; rmdir ' + sq(lock) + ' 2>/dev/null');
}

function op_lock_take() {
	let td = tmpdir(), lock = td + '/operation.lock';
	let take = 'mkdir -p ' + sq(td) + ' && mkdir ' + sq(lock) + ' 2>/dev/null';
	if (sh(take).rc == 0) return lock;
	if (op_lock_alive(lock)) return null;
	op_lock_release(lock);
	return sh(take).rc == 0 ? lock : null;
}

function op_lock_run(lock, inner) {
	return sh('( ' + inner + '; rm -f ' + sq(lock + '/pid') + '; rmdir ' + sq(lock) + ' 2>/dev/null ) >/dev/null 2>&1 & { echo $! > ' + sq(lock + '/pid') + '; } 2>/dev/null; :').rc == 0;
}

function applyNetwork(p) {
	let token = replace('' + (p.token || ''), /[^a-zA-Z0-9_-]/g, '');
	if (token == '') return { accepted: false, error: 'bad_token' };
	let td = tmpdir();
	let inner = "out=$(" + sq(initd()) + " firewall_apply 2>&1); rc=$?; { echo $rc; date +%s; printf '%s\\n' " + sq(token) + "; printf '%s\\n' \"$out\"; } > " + sq(td + "/fw-apply.stamp");
	let lock = op_lock_take();
	if (lock == null)
		return { accepted: false, busy: true };
	if (!op_lock_run(lock, inner)) {
		op_lock_release(lock);
		return { accepted: false, error: 'action_fail' };
	}
	return { accepted: true };
}

function applyCron(p) {
	let days = clean_int(cfg('update', 'every_days', '7'), 7, 1, 30);
	let jit = clean_int(cfg('update', 'jitter', '600'), 600, 0, 3600);
	let att = cfg('update', 'at_time', '03:30');
	let hh = 3, mm = 30;
	let ap = split(att, ':');
	if (length(ap) == 2) {
		hh = clean_int(ap[0], 3, 0, 23);
		mm = clean_int(ap[1], 30, 0, 59);
	}
	let auto = cfg('update', 'auto_update', '0');
	let cmd = sq(libdir() + '/update.sh') + ' auto';
	let cronf = getenv2('TS_CRON_FILE', '/etc/crontabs/root');
	let cur = '';
	try { cur = readfile(cronf); } catch (e) { cur = ''; }
	if (cur == null) cur = '';
	let body = rtrim(cur, '\n');
	let keep = '';
	for (let ln in (body == '' ? [] : split(body, '\n'))) {
		if (substr(ln, 0, 16) == '# tailscale-auto') continue;
		if (index(ln, cmd) >= 0 || index(ln, 'update.sh --auto') >= 0 || index(ln, 'update.sh auto') >= 0 || index(ln, 'wrapper.sh auto-update') >= 0) continue;
		keep = keep + ln + '\n';
	}
	if (auto == '1') {
		let line = sprintf('%d %d */%d * * %s\n', mm, hh, days, cmd);
		if (jit > 0)
			line = sprintf('%d %d */%d * * sleep $((RANDOM %% %d)); %s\n', mm, hh, days, jit, cmd);
		keep = keep + '# tailscale-auto-begin\n' + line + '# tailscale-auto-end\n';
	}
	if (keep == cur) return { ok: true };
	try {
		writefile(cronf, keep);
	} catch (e) {
		return { ok: false, error: 'cron_write_fail' };
	}
	let cr = sh(sq(getenv2('TS_CRON_INIT', '/etc/init.d/cron')) + ' restart >/dev/null 2>&1');
	if (cr.rc != 0) return { ok: false, error: 'cron_restart_fail' };
	return { ok: true };
}

