function parse_sec(ds) {
	let parts = split(ds, '.');
	let sec = int(parts[0]) || 0;
	let msec = 0;
	if (length(parts) > 1) {
		let fr = parts[1];
		while (length(fr) < 3) fr = fr + '0';
		msec = int(substr(fr, 0, 3)) || 0;
	}
	return sec * 1000 + msec;
}

function pingPeers(p) {
