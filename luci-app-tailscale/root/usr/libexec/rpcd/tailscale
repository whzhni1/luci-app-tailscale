#!/usr/bin/ucode
import { cursor } from 'uci';
import { popen, readfile, writefile, stdin, unlink, glob, stat } from 'fs';

const WL = {
	main: ['enabled', 'bin_dir', 'state_dir', 'socket', 'tun', 'mode', 'port', 'socks5', 'http_proxy', 'start_delay', 'respawn_threshold', 'respawn_timeout', 'respawn_retry', 'log_enabled', 'log_limit_kb', 'log_errors_only', 'theme', 'tmp_dir', 'derp_preferred_region'],
	up: ['hostname', 'auth_key', 'accept_dns', 'accept_routes', 'advertise_routes', 'advertise_exit_node', 'exit_node', 'exit_node_allow_lan', 'shields_up', 'snat_subnet_routes', 'ssh', 'operator', 'login_server', 'netfilter_mode', 'stateful_filtering'],
	network: ['iface_enabled', 'iface_name', 'zone_enabled', 'zone_name', 'masq', 'mss', 'fwd_ts_lan', 'fwd_lan_ts', 'fwd_ts_wan', 'fwd_wan_ts', 'conflicts', 'reload_network_on_stop'],
	update: ['channel', 'source_order', 'arch', 'version', 'file', 'lang', 'auto_update', 'auto_rollback', 'service_wait_seconds', 'every_days', 'at_time', 'keep_backup', 'timeout', 'retry', 'cache_ttl', 'dl_timeout', 'jitter']
};

const SOCKET_WAITS = 5;
const UP_TIMEOUT = 600;
const STATUS_REFRESH_INTERVAL = 5;
const STATUS_REFRESH_LOCK_MAX_AGE = 60;

function getenv2(k, dflt) {
	let v = getenv(k);
	if (v == null || v == '') return dflt;
	return v;
}

function new_cursor() {
	let d = getenv2('TS_UCI_DIR', '');
	if (d != '')
		return cursor(d, getenv2('TS_UCI_DELTA', '/tmp/.uci-test'));
	return cursor();
}

let _C = null;
function U() {
	if (_C == null) {
		try { _C = new_cursor(); } catch (e) { _C = null; }
	}
	return _C;
}

function cfg(sec, opt, dflt) {
	let v = null;
	try { v = U().get('tailscale', sec, opt); } catch (e) { v = null; }
	if (v == null || v == '') return dflt;
	return v;
}

function libdir() { return getenv2('TS_LIBDIR', '/usr/libexec/tailscale'); }
function initd() { return getenv2('TS_SELF_INIT', '/etc/init.d/tailscale'); }
function tmpdir() { return cfg('main', 'tmp_dir', '/tmp/tailscale'); }
function bindir() { return cfg('main', 'bin_dir', '/usr/sbin'); }
function sockpath() { return cfg('main', 'socket', '/var/run/tailscale/tailscaled.sock'); }

function sh(cmd) {
	let p = null;
	try { p = popen(cmd, 'r'); } catch (e) { return { rc: 127, out: '' }; }
	if (p == null) return { rc: 127, out: '' };
	let out = '';
	try { out = p.read('all'); } catch (e) { out = ''; }
	if (out == null) out = '';
	let rc = 1;
	try { rc = p.close(); } catch (e) { rc = 1; }
	return { rc: rc, out: out };
}

function jread(path) {
	let txt = null;
	try { txt = readfile(path); } catch (e) { return null; }
	if (txt == null || trim(txt) == '') return null;
	try { return json(txt); } catch (e) { return null; }
}

function sq(s) {
	return "'" + join("'\\''", split(s || '', "'")) + "'";
}

function existingPath(path) {
	let p = '' + (path || '/');
	while (p != '/' && stat(p) == null) {
		let i = rindex(p, '/');
		p = i > 0 ? substr(p, 0, i) : '/';
	}
	return p;
}

function diskSpace(path) {
	let r = sh('df -Pk ' + sq(existingPath(path)) + " 2>/dev/null | awk 'NR==2 { printf \"%.0f %.0f\\n\", $2 * 1024, $4 * 1024 }'");
	if (r.rc != 0) return { path: path, total_bytes: 0, free_bytes: 0 };
	let fields = split(trim(r.out), ' ');
	if (length(fields) < 2) return { path: path, total_bytes: 0, free_bytes: 0 };
	let total = int(fields[0]) || 0, free = int(fields[1]) || 0;
	return { path: path, total_bytes: total, free_bytes: free };
}

function diskSpaces() {
	let home = getenv2('HOME', '/root');
	let cache = getenv2('XDG_CACHE_HOME', home + '/.cache');
	if (sh('test -d ' + sq(cache) + ' 2>/dev/null').rc != 0) cache = home;
	return { install: diskSpace(bindir()), temporary: diskSpace(tmpdir()), cache: diskSpace(cache) };
}

function updateSpaceSummary(spaces, channel) {
	let names = ['install', 'temporary'];
	if (channel == 'official') names[length(names)] = 'cache';
	let location = names[0];
	let selected = spaces[location] || { path: '', total_bytes: 0, free_bytes: 0 };
	for (let i = 1; i < length(names); i++) {
		let current = spaces[names[i]] || { path: '', total_bytes: 0, free_bytes: 0 };
		if (current.total_bytes > 0 && (selected.total_bytes <= 0 || current.free_bytes < selected.free_bytes)) {
			selected = current;
			location = names[i];
		}
	}
	return { path: selected.path, location: location, total_bytes: selected.total_bytes, free_bytes: selected.free_bytes };
}

function redactLogText(text) {
	text = '' + (text || '');
	text = replace(text, /--auth-key=[^' \t\r\n]+/g, '--auth-key=[redacted]');
	text = replace(text, /tskey-[A-Za-z0-9_-]+/g, '[auth-key redacted]');
	return replace(text, /https?:\/\/[^ \t\r\n]+/g, '[URL redacted]');
}

function logTailscale(cmd, rc, output) {
	if (cfg('main', 'log_enabled', '1') != '1') return;
	let td = tmpdir(), file = td + '/backend.log';
	let stamp = trim(sh("date '+%Y-%m-%d %H:%M:%S' 2>/dev/null").out);
	let text = '[' + stamp + '] $ ' + redactLogText(cmd) + ' (result=' + rc + ')\n';
	let clean = redactLogText(output);
	let wrote = false;
	for (let line in split(clean, '\n')) {
		if (trim(line) == '') continue;
		text = text + '>> ' + line + '\n';
		wrote = true;
	}
	if (!wrote) text = text + '>> (no output)\n';
	if (sh('mkdir -p ' + sq(td) + ' && printf %s ' + sq(text) + ' >> ' + sq(file)).rc != 0) return;
	let limitKb = int(cfg('main', 'log_limit_kb', '300')) || 300;
	if (limitKb < 16) limitKb = 16;
	if (limitKb > 4096) limitKb = 4096;
	let size = int(trim(sh('wc -c < ' + sq(file) + ' 2>/dev/null').out)) || 0;
	if (size > limitKb * 1024) {
		let keep = int(limitKb * 512);
		sh('tail -c ' + keep + ' ' + sq(file) + ' > ' + sq(file + '.tmp') + ' && mv -f ' + sq(file + '.tmp') + ' ' + sq(file));
	}
}

function sh_bounded(cmd, seconds) {
	let td = tmpdir();
	let stamp = clock();
	let id = sprintf('rpc-%d-%d', stamp[0], stamp[1]);
	let outFile = td + '/' + id + '.out';
	let rcFile = td + '/' + id + '.rc';
	let pidFile = td + '/' + id + '.pid';
	if (sh('mkdir -p ' + sq(td)).rc != 0)
		return { rc: 127, out: '' };
	let launch = '( sh -c ' + sq(cmd) + ' > ' + sq(outFile) + ' 2>&1; echo $? > ' + sq(rcFile) + ' ) >/dev/null 2>&1 & echo $! > ' + sq(pidFile);
	if (sh(launch).rc != 0)
		return { rc: 127, out: '' };
	let limit = int(seconds) || 1;
	for (let i = 0; i <= limit; i++) {
		let rc = null;
		try { rc = readfile(rcFile); } catch (e) { rc = null; }
		if (rc != null && trim(rc) != '') {
			let output = '';
			try { output = readfile(outFile) || ''; } catch (e) {}
			sh('rm -f ' + sq(outFile) + ' ' + sq(rcFile) + ' ' + sq(pidFile));
			return { rc: int(trim(rc)) || 0, out: output };
		}
		if (i < limit)
			sh('sleep 1');
	}
	let pid = null;
	try { pid = trim(readfile(pidFile)); } catch (e) { pid = null; }
	if (pid != null && pid != '') {
		let tree = descendants(pid);
		for (let child in tree) sh('kill ' + child + ' 2>/dev/null');
		sh('kill ' + pid + ' 2>/dev/null');
		sh('sleep 1');
		for (let child in tree) sh('kill -9 ' + child + ' 2>/dev/null');
		sh('kill -9 ' + pid + ' 2>/dev/null');
	}
	let output = '';
	try { output = readfile(outFile) || ''; } catch (e) {}
	sh('rm -f ' + sq(outFile) + ' ' + sq(rcFile) + ' ' + sq(pidFile));
	return { rc: 124, out: output };
}

function clean_id(id) {
	if (id == null) return null;
	let s = '' + id;
	if (s == '') return null;
	for (let i = 0; i < length(s); i++) {
		if (index('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-', substr(s, i, 1)) < 0)
			return null;
	}
	return s;
}

function clean_int(v, dflt, lo, hi) {
	let n = null;
	try { n = int(v); } catch (e) { n = null; }
	if (n == null || !(n >= lo)) n = dflt;
	if (n < lo) n = lo;
	if (n > hi) n = hi;
	return n;
}

function src_list(single) {
	if (single != null && single != '' && single != 'auto') {
		if (index(['gitlab', 'r2', 'github', 'official'], single) < 0)
			return null;
		return [single];
	}
	let order = cfg('update', 'source_order', 'gitlab github r2');
	if (order == 'gitlab r2 github') order = 'gitlab github r2';
	return filter(split(order, ' '), (x) => x != '');
}

function proj_of(p) {
	if (p.proj == 'luci-app-tailscale') return 'luci-app-tailscale';
	return 'tailscale';
}

function local_route_candidates() {
	let result = sh('ip -4 route show table main 2>/dev/null');
	if (result.rc != 0) return [];
	let candidates = [], seen = {};
	let tailscaleTun = cfg('main', 'tun', 'tailscale0');
	for (let line in split(result.out, '\n')) {
		let fields = filter(split(trim(line), ' '), (x) => x != '');
		if (length(fields) < 3) continue;
		let cidr = fields[0];
		if (cidr == 'default') continue;
		let parts = split(cidr, '/');
		if (length(parts) != 2) continue;
		let octets = split(parts[0], '.');
		if (length(octets) != 4) continue;
		let valid = true;
		for (let i = 0; i < 4; i++) {
			if (octets[i] == '') {
				valid = false;
				break;
			}
			for (let j = 0; j < length(octets[i]); j++)
				if (index('0123456789', substr(octets[i], j, 1)) < 0) valid = false;
			let octet = int(octets[i]);
			if (octet == null || octet < 0 || octet > 255) valid = false;
		}
		if (parts[1] == '') valid = false;
		for (let j = 0; j < length(parts[1]); j++)
			if (index('0123456789', substr(parts[1], j, 1)) < 0) valid = false;
		let prefix = int(parts[1]);
		if (prefix == null || prefix < 1 || prefix > 31) valid = false;
		if (!valid) continue;
		let device = '', direct = false, via = false;
		for (let i = 1; i < length(fields); i++) {
			if (fields[i] == 'dev' && i + 1 < length(fields)) device = fields[i + 1];
			else if (fields[i] == 'scope' && i + 1 < length(fields) && fields[i + 1] == 'link') direct = true;
			else if (fields[i] == 'proto' && i + 1 < length(fields) && fields[i + 1] == 'kernel') direct = true;
			else if (fields[i] == 'via') via = true;
		}
		let tunnel = device == tailscaleTun || substr(device, 0, 9) == 'tailscale' || substr(device, 0, 3) == 'tun' || substr(device, 0, 4) == 'utun' || substr(device, 0, 3) == 'tap' || substr(device, 0, 2) == 'wg' || substr(device, 0, 3) == 'ppp' || substr(device, 0, 3) == 'gre' || substr(device, 0, 3) == 'sit' || substr(device, 0, 3) == 'vti' || substr(device, 0, 2) == 'zt' || substr(device, 0, 6) == 'docker' || substr(device, 0, 5) == 'virbr';
		if (!direct || via || device == '' || device == 'lo' || tunnel) continue;
		if (seen[cidr] == true) continue;
		seen[cidr] = true;
		candidates[length(candidates)] = { cidr: cidr, device: device };
		if (length(candidates) >= 64) break;
	}
	return candidates;
}

function inTailnetRange(cidr) {
	let parts = split(cidr, '/'), octets = split(parts[0], '.'), len = int(parts[1]);
	let shift = 32 - (len < 10 ? len : 10);
	let addr = ((int(octets[0]) * 256 + int(octets[1])) * 256 + int(octets[2])) * 256 + int(octets[3]);
	return (addr >> shift) == (0x64400000 >> shift);
}

function protectLocalRoutes() {
	let want = {}, have = {};
	if (cfg('main', 'mode', 'tun') != 'userspace')
		for (let route in local_route_candidates())
			if (!inTailnetRange(route.cidr)) want[route.cidr] = true;
	for (let line in split(sh('ip -4 rule show 2>/dev/null').out, '\n')) {
		let m = match(trim(line), /^5200:[[:space:]]+from all to ([^[:space:]]+) lookup main/);
		if (m) have[m[1]] = true;
	}
	for (let cidr in have)
		if (!want[cidr]) sh('ip -4 rule del to ' + sq(cidr) + ' table main priority 5200 2>/dev/null');
	for (let cidr in want)
		if (!have[cidr]) sh('ip -4 rule add to ' + sq(cidr) + ' table main priority 5200 2>/dev/null');
}

function routerModelRaw() {
	let model = '';
	try { model = trim(readfile('/tmp/sysinfo/model')); } catch (e) { model = ''; }
	if (model == '') {
		let br = sh('ubus call system board 2>/dev/null');
		if (br.rc == 0) {
			let board = null;
			try { board = json(br.out); } catch (e) { board = null; }
			if (board != null && board.model != null) model = '' + board.model;
		}
	}
	return trim(model);
}

function routerModel() {
	let model = routerModelRaw();
	if (model == '') {
		let hn = sh('uname -n 2>/dev/null');
		if (hn.rc == 0) model = trim(hn.out);
	}
	if (model == '') return '';
	return trim(sh('printf %s ' + sq(model) + " | sed 's/[^A-Za-z0-9-]//g; s/--*/-/g; s/^-*//; s/-*$//'").out);
}

function getConfig(p) {
	let sec = p.section;
	let single = (sec != null && sec != '');
	if (single && WL[sec] == null)
		return { ok: false, error: 'bad_section' };
	let secs = single ? [sec] : ['main', 'up', 'network', 'update'];
	let out = {};
	for (let s in secs) {
		let o = {};
		let all = null;
		try { all = U().get_all('tailscale', s); } catch (e) { all = null; }
		if (all == null) all = {};
		for (let k, v in all) {
			if (substr(k, 0, 1) == '.') continue;
			if (s == 'up' && k == 'auth_key') {
				o[k] = (v != null && v != '') ? true : false;
				continue;
			}
			o[k] = v;
		}
		out[s] = o;
	}
	if (single) return { ok: true, config: out[sec] };
	return { ok: true, config: out, local_routes: local_route_candidates(), router_model: routerModel() };
}

function normalize_derp_region(v) {
	if (v == null || v == '' || v == 'auto' || v == 0 || v == '0') return '0';
	let s = '' + v;
	if (length(s) > 9) return null;
	for (let i = 0; i < length(s); i++) {
		if (index('0123456789', substr(s, i, 1)) < 0) return null;
	}
	let n = int(s);
	if (n == null || n < 1 || n > 2147483647) return null;
	return '' + n;
}

function read_derp_map() {
	let r = sh(sq(bindir() + '/tailscale') + ' --socket=' + sq(sockpath()) + ' debug derp-map 2>/dev/null');
	if (r.rc != 0) return { available: false, regions: [] };
	let data = null;
	try { data = json(r.out); } catch (e) { data = null; }
	if (data == null || data.Regions == null || type(data.Regions) != 'object')
		return { available: false, regions: [] };
	let regions = [];
	for (let k, item in data.Regions) {
		if (item == null || item.RegionID == null || item.Nodes == null || length(item.Nodes) == 0)
			continue;
		let id = int(item.RegionID);
		if (id < 1) continue;
		let code = item.RegionCode == null ? '' : trim('' + item.RegionCode);
		let name = item.RegionName == null ? '' : trim('' + item.RegionName);
		if (name == '') name = code != '' ? code : 'Region ' + id;
		regions[length(regions)] = { id: id, code: code, name: name };
	}
	return { available: true, regions: regions };
}

function force_derp_region(region) {
	return sh(sq(bindir() + '/tailscale') + ' --socket=' + sq(sockpath()) + ' debug force-prefer-derp ' + region + ' 2>/dev/null').rc == 0;
}

function setConfig(p) {
	let sec = p.section;
	if (sec == null || WL[sec] == null)
		return { ok: false, error: 'bad_section' };
	let vals = p.values;
	if (vals == null) vals = {};
	if (type(vals) != 'object')
		return { ok: false, error: 'bad_values' };
	for (let k, v in vals) {
		if (index(WL[sec], k) < 0)
			return { ok: false, error: 'bad_option' };
	}
	let derpRegion = null;
	if (sec == 'main' && vals.derp_preferred_region != null) {
		derpRegion = normalize_derp_region(vals.derp_preferred_region);
		if (derpRegion == null)
			return { ok: false, error: 'bad_derp_region' };
	}
	let applyNow = p.apply == true || p.apply == 1 || p.apply == '1';
	try {
		for (let k, v in vals) {
			let s = v;
			if (sec == 'main' && k == 'derp_preferred_region') s = derpRegion;
			else if (s == true) s = '1';
			else if (s == false) s = '0';
			else s = '' + s;
			U().set('tailscale', sec, k, s);
		}
		if (U().commit('tailscale') != true)
			return { ok: false, error: 'commit_fail' };
	} catch (e) {
		return { ok: false, error: 'commit_fail' };
	}
	if (derpRegion == null || !applyNow)
		return { ok: true };
	if (sh('test -S ' + sq(sockpath()) + ' 2>/dev/null').rc != 0)
		return { ok: true, applied: derpRegion == '0', deferred: derpRegion != '0', derp_preferred_region: derpRegion };
	let validRegion = derpRegion == '0';
	if (!validRegion) {
		let map = read_derp_map();
		if (map.available) {
			for (let region in map.regions) {
				if ('' + region.id == derpRegion) {
					validRegion = true;
					break;
				}
			}
		}
	}
	if (validRegion && force_derp_region(derpRegion))
		return { ok: true, applied: true, derp_preferred_region: derpRegion };
	if (derpRegion == '0')
		return { ok: true, applied: false, deferred: true, derp_preferred_region: '0' };
	let cleared = force_derp_region('0');
	let reverted = false;
	try {
		U().set('tailscale', 'main', 'derp_preferred_region', '0');
		reverted = U().commit('tailscale') == true;
	} catch (e) {}
	if (!reverted)
		return { ok: false, error: 'commit_fail', applied: cleared, derp_preferred_region: derpRegion };
	return { ok: true, applied: cleared, deferred: !cleared, fallback_auto: true, derp_preferred_region: '0' };
}

function buildStatus(p) {
	let bin = bindir();
	let channel = cfg('update', 'channel', 'custom');
	let rollback = cfg('update', 'auto_rollback', '1');
	let spaces = diskSpaces();
	let res = { running: false, logged_in: false, binary_ok: false, tailscaled_ok: false, tailscale_cli_ok: false, enabled: false, version: '', tail_ips: [], hostname: '', router_model: '', arch: '', tailnet: '', key_expiry: '', peers: [], uptime: 0, rx_bytes: 0, tx_bytes: 0, tailscale_cpu_pct: null, tailscale_proc_ticks: 0, tailscale_pid: '', tailscale_start_ticks: 0, backend_state: '', cpu_total_ticks: 0, cpu_cores: 1, tailscale_mem_kb: 0, cpu_stat: '', mem_total: 0, mem_avail: 0, load1: '', derp_ms: {}, fw_driver: 'none', fw_zone: false, fw_iface: false, fw_apply: null };
	res.update_channel = channel;
	res.auto_rollback = rollback == '1';
	res.disk_spaces = spaces;
	res.update_space = updateSpaceSummary(spaces, channel);
	res.enabled = cfg('main', 'enabled', '0') == '1';
	res.tailscaled_ok = sh('test -x ' + sq(bin + '/tailscaled') + ' 2>/dev/null').rc == 0;
	res.tailscale_cli_ok = sh('test -x ' + sq(bin + '/tailscale') + ' 2>/dev/null').rc == 0;
	res.binary_ok = res.tailscaled_ok && res.tailscale_cli_ok;
	if (res.tailscale_cli_ok) {
		let v = sh(sq(bin + '/tailscale') + ' version 2>/dev/null');
		if (v.rc == 0) {
			let vl = split(trim(v.out), '\n');
			if (length(vl) > 0) res.version = trim(vl[0]);
		}
	}
	let s = sh_bounded(sq(bin + '/tailscale') + ' --socket=' + sq(sockpath()) + ' status --json 2>/dev/null', 8);
	let st = null;
	if (s.rc == 0) {
		try { st = json(s.out); } catch (e) { st = null; }
	}
	if (st != null) {
		res.running = true;
		if (st.BackendState != null) res.backend_state = '' + st.BackendState;
		if (st.BackendState == 'Running') res.logged_in = true;
		let self = st.Self;
		if (self == null) self = {};
		if (self.TailscaleIPs != null) res.tail_ips = self.TailscaleIPs;
		if (self.HostName != null) res.hostname = self.HostName;
		if (self.KeyExpiry != null) res.key_expiry = self.KeyExpiry;
		if (self.DNSName != null) {
			let dp = split(self.DNSName, '.');
			if (length(dp) >= 3) res.tailnet = dp[1];
		}
		let peers = st.Peer;
		if (peers == null) peers = {};
		for (let nk, pr in peers) {
			let pip = '';
			if (pr.TailscaleIPs != null && length(pr.TailscaleIPs) > 0) pip = pr.TailscaleIPs[0];
			if (pip == null) pip = '';
			let own = {};
			if (pr.TailscaleIPs != null) {
				for (let oip in pr.TailscaleIPs) own[oip] = true;
			}
			let adv = [];
			if (pr.AllowedIPs != null) {
				for (let a in pr.AllowedIPs) {
					if (a == '0.0.0.0/0' || a == '::/0') continue;
					let bare = split(a, '/')[0];
					if (own[bare] == true) continue;
					adv[length(adv)] = a;
				}
			}
			let appr = [];
			if (pr.PrimaryRoutes != null) {
				for (let a in pr.PrimaryRoutes) appr[length(appr)] = a;
			}
			let pend = [];
			for (let a in adv) {
				if (index(appr, a) < 0) pend[length(pend)] = a;
			}
			let ls = '';
			let relay = '';
			let curAddr = '';
			let online = pr.Online == true;
			if (pr.LastSeen != null) ls = pr.LastSeen;
			if (pr.Relay != null) relay = trim('' + pr.Relay);
			if (pr.CurAddr != null) curAddr = trim('' + pr.CurAddr);
			res.peers[length(res.peers)] = { key: nk, name: pr.HostName || '', dns: pr.DNSName || '', ip: pip, os: pr.OS || '', online: online, active: pr.Active == true, direct: (online && curAddr != '' && relay == ''), relay: relay, lastseen: ls, exit_option: pr.ExitNodeOption == true, exit_active: pr.ExitNode == true, approved: appr, pending: pend, rx_bytes: pr.RxBytes || 0, tx_bytes: pr.TxBytes || 0 };
		}
	}
	let dev = cfg('main', 'tun', 'tailscale0');
	let nd = null;
	try { nd = readfile('/proc/net/dev'); } catch (e) { nd = null; }
	if (nd != null) {
		for (let ln in split(nd, '\n')) {
			let t = trim(ln);
			if (substr(t, 0, length(dev) + 1) == dev + ':') {
				let f = filter(split(t, ' '), (x) => x != '');
				if (length(f) >= 10) {
					res.rx_bytes = int(f[1]) || 0;
					res.tx_bytes = int(f[9]) || 0;
				}
			}
		}
	}
	let mi = null;
	try { mi = readfile('/proc/meminfo'); } catch (e) { mi = null; }
	if (mi != null) {
		for (let ln in split(mi, '\n')) {
			let f = filter(split(trim(ln), ' '), (x) => x != '');
			if (length(f) >= 2) {
				if (f[0] == 'MemTotal:') res.mem_total = int(f[1]) || 0;
				if (f[0] == 'MemAvailable:') res.mem_avail = int(f[1]) || 0;
			}
		}
	}
	let la = null;
	try { la = readfile('/proc/loadavg'); } catch (e) { la = null; }
	if (la != null) {
		let f = filter(split(trim(la), ' '), (x) => x != '');
		if (length(f) > 0) res.load1 = f[0];
	}

	let arch = sh('uname -m 2>/dev/null');
	if (arch.rc == 0) res.arch = trim(arch.out);
	let model = null;
	try { model = readfile('/tmp/sysinfo/model'); } catch (e) { model = null; }
	if (model != null) res.router_model = trim(model);
	if (res.router_model == '') {
		let br = sh('ubus call system board 2>/dev/null');
		if (br.rc == 0) {
			let board = null;
			try { board = json(br.out); } catch (e) { board = null; }
			if (board != null && board.model != null) res.router_model = '' + board.model;
		}
	}
	let pstat = null;
	try { pstat = readfile('/proc/stat'); } catch (e) { pstat = null; }
	let totalTicks = 0, cpuCount = 0;
	if (pstat != null) {
		for (let ln in split(pstat, '\n')) {
			let f = filter(split(trim(ln), ' '), (x) => x != '');
			if (length(f) == 0) continue;
			if (f[0] == 'cpu') {
				res.cpu_stat = trim(ln);
				for (let i = 1; i < length(f); i++) totalTicks += int(f[i]) || 0;
			}
			else if (substr(f[0], 0, 3) == 'cpu') {
				cpuCount++;
			}
		}
	}
	res.cpu_total_ticks = totalTicks;
	res.cpu_cores = cpuCount > 0 ? cpuCount : 1;
	let pidout = sh('pidof tailscaled 2>/dev/null');
	let pid = '';
	if (pidout.rc == 0) {
		let pids = filter(split(trim(pidout.out), ' '), (x) => x != '');
		if (length(pids) > 0) pid = pids[0];
	}
	let procTicks = 0, procStartTicks = 0;
	let procStat = null;
	if (pid != '') {
		if (!res.running && sh('test -S ' + sq(sockpath()) + ' 2>/dev/null').rc == 0) res.running = true;
		try { procStat = readfile('/proc/' + pid + '/stat'); } catch (e) { procStat = null; }
		if (procStat != null) {
			let close = index(procStat, ') ');
			if (close >= 0) {
				let f = filter(split(trim(substr(procStat, close + 2)), ' '), (x) => x != '');
				if (length(f) > 12) {
					procTicks = (int(f[11]) || 0) + (int(f[12]) || 0);
					res.tailscale_pid = pid;
					res.tailscale_proc_ticks = procTicks;
					if (length(f) > 19)
						procStartTicks = int(f[19]) || 0;
					res.tailscale_start_ticks = procStartTicks;
				}
			}
		}
		let pst = null;
		try { pst = readfile('/proc/' + pid + '/status'); } catch (e) { pst = null; }
		if (pst != null) {
			for (let ln in split(pst, '\n')) {
				let f = filter(split(replace(trim(ln), /[ \t]+/g, ' '), ' '), (x) => x != '');
				if (length(f) >= 2 && f[0] == 'VmRSS:') res.tailscale_mem_kb = int(f[1]) || 0;
			}
		}
		if (procStat != null && totalTicks > 0 && cpuCount > 0) {
			let td = tmpdir();
			sh('mkdir -p ' + sq(td) + ' 2>/dev/null');
			let prev = jread(td + '/tailscale-cpu.json');
			if (prev != null && prev.pid == pid && totalTicks > prev.total && procTicks >= prev.proc) {
				let pcpu = (procTicks - prev.proc) * cpuCount * 100 / (totalTicks - prev.total);
				if (pcpu >= 0) res.tailscale_cpu_pct = pcpu;
			}
			try { writefile(td + '/tailscale-cpu.json', sprintf('%J', { pid: pid, proc: procTicks, total: totalTicks })); } catch (e) {}
		}
	}
	let procUptime = -1;
	if (procStartTicks > 0) {
		let bootTime = null;
		try { bootTime = readfile('/proc/uptime'); } catch (e) {}
		if (bootTime != null) {
			let fields = filter(split(trim(bootTime), ' '), (x) => x != '');
			if (length(fields) > 0) {
				let hz = 100;
				let hzout = sh('getconf CLK_TCK 2>/dev/null');
				if (hzout.rc == 0) hz = int(trim(hzout.out)) || 100;
				let bootUptime = int(split(fields[0], '.')[0]) || 0;
				procUptime = bootUptime - int(procStartTicks / hz);
			}
		}
	}
	if (procUptime >= 0) res.uptime = procUptime;
	let td = tmpdir();
	let pc = jread(td + '/ping.json');
	if (pc != null && pc.latency != null) res.derp_ms = pc.latency;
	let fw = sh(sq(initd()) + ' firewall_status 2>/dev/null');
	if (fw.rc == 0) {
		let f = null;
		try { f = json(fw.out); } catch (e) { f = null; }
		if (f != null) {
			if (f.driver != null) res.fw_driver = f.driver;
			if (f.zone == true) res.fw_zone = true;
			if (f.iface == true) res.fw_iface = true;
		}
	}
	let fst = null;
	try { fst = readfile(td + '/fw-apply.stamp'); } catch (e) { fst = null; }
	if (fst != null) {
		let fl = split(trim(fst), '\n');
		if (length(fl) >= 2) {
			let fo = '';
			let id = '';
			if (length(fl) > 2) id = fl[2];
			if (length(fl) > 3) fo = fl[3];
			res.fw_apply = { rc: fl[0], at: fl[1], id: id, out: fo };
		}
	}
	if (p.include_derp_map == true || p.include_derp_map == 1 || p.include_derp_map == '1') {
		let map = read_derp_map();
		res.derp_map_available = map.available;
		res.derp_regions = map.regions;
	}
	return res;
}

function status_snapshot_path() {
	return tmpdir() + '/status-v1.json';
}

function status_refresh_lock() {
	return tmpdir() + '/status-refresh.lock';
}

function read_status_snapshot() {
	let snapshot = jread(status_snapshot_path());
	if (snapshot == null || snapshot.status == null) return null;
	let at = null;
	try { at = int(snapshot.at); } catch (e) { at = null; }
	let now = int(clock()[0]) || 0;
	if (at == null || at < 1 || at > now + 5) return null;
	return { at: at, status: snapshot.status };
}

function write_status_snapshot(status) {
	let tc = clock(), at = int(tc[0]) || 0, path = status_snapshot_path();
	if (at < 1 || sh('mkdir -p ' + sq(tmpdir())).rc != 0) return 0;
	let temp = path + '.' + tc[0] + '-' + tc[1] + '.tmp';
	try {
		writefile(temp, sprintf('%J', { at: at, status: status }));
	} catch (e) {
		return 0;
	}
	if (sh('mv -f ' + sq(temp) + ' ' + sq(path) + ' 2>/dev/null').rc != 0) {
		try { unlink(temp); } catch (e) {}
		return 0;
	}
	return at;
}

function live_traffic_counters() {
	let counters = {};
	let dev = cfg('main', 'tun', 'tailscale0');
	let nd = null;
	try { nd = readfile('/proc/net/dev'); } catch (e) { nd = null; }
	if (nd == null) return counters;
	for (let ln in split(nd, '\n')) {
		let t = trim(ln);
		if (substr(t, 0, length(dev) + 1) != dev + ':') continue;
		let fields = filter(split(t, ' '), (x) => x != '');
		if (length(fields) >= 10) {
			counters.rx_bytes = int(fields[1]) || 0;
			counters.tx_bytes = int(fields[9]) || 0;
		}
		break;
	}
	return counters;
}

function status_snapshot_result(snapshot) {
	let result = {};
	for (let key, value in snapshot.status) result[key] = value;
	let age = (int(clock()[0]) || snapshot.at) - snapshot.at;
	result.status_age_seconds = age > 0 ? age : 0;
	let pc = jread(tmpdir() + '/ping.json');
	if (pc != null && pc.latency != null) result.derp_ms = pc.latency;
	let counters = live_traffic_counters();
	for (let key, value in counters) result[key] = value;
	return result;
}

function start_status_refresh() {
	let td = tmpdir(), lock = status_refresh_lock(), now = int(clock()[0]) || 0;
	let started = null, lockExists = false, lockText = null;
	try { lockText = readfile(lock + '/started'); } catch (e) { lockText = null; }
	if (lockText != null) {
		lockExists = true;
		try { started = int(trim(lockText)); } catch (e) { started = null; }
	}
	if (!lockExists || started == null || started < 1) {
		let stamp = sh('stat -c %Y ' + sq(lock) + ' 2>/dev/null');
		if (stamp.rc == 0) {
			started = int(trim(stamp.out)) || 0;
			lockExists = true;
		}
	}
	if (lockExists) {
		if (started > 0 && now - started <= STATUS_REFRESH_LOCK_MAX_AGE) return false;
		sh('rm -rf ' + sq(lock));
	}
	if (sh('mkdir -p ' + sq(td) + ' && mkdir ' + sq(lock) + ' 2>/dev/null').rc != 0) return false;
	try {
		writefile(lock + '/started', '' + now);
	} catch (e) {
		sh('rm -rf ' + sq(lock));
		return false;
	}
	let self = getenv2('TS_RPCD_SELF', '/usr/libexec/rpcd/tailscale');
	let payload = '{"force_refresh":"1"}';
	let cmd = '( printf %s ' + sq(payload) + ' | ' + sq(self) + ' call getStatus >/dev/null 2>&1; rm -rf ' + sq(lock) + ' ) >/dev/null 2>&1 &';
	if (sh(cmd).rc != 0) {
		sh('rm -rf ' + sq(lock));
		return false;
	}
	return true;
}

function getStatus(p) {
	let force = p.force_refresh == true || p.force_refresh == 1 || p.force_refresh == '1';
	let withDerp = p.include_derp_map == true || p.include_derp_map == 1 || p.include_derp_map == '1';
	if (force || withDerp) {
		let status = buildStatus(p);
		let at = write_status_snapshot(status);
		status.status_updated_at = at > 0 ? at : (int(clock()[0]) || 0);
		status.status_age_seconds = 0;
		return status;
	}
	let snapshot = read_status_snapshot();
	if (snapshot == null) {
		let status = buildStatus(p);
		let at = write_status_snapshot(status);
		status.status_updated_at = at > 0 ? at : (int(clock()[0]) || 0);
		status.status_age_seconds = 0;
		return status;
	}
	let now = int(clock()[0]) || snapshot.at;
	if (now - snapshot.at >= STATUS_REFRESH_INTERVAL)
		start_status_refresh();
	return status_snapshot_result(snapshot);
}

function getSources(p) {
	let proj = proj_of(p);
	let td = tmpdir();
	let source = p.source == null || p.source == '' ? null : '' + p.source;
	let order = source == null ? src_list(null) : src_list(source);
	if (order == null || (source == 'official' && proj != 'tailscale')) return { ok: false, error: 'bad_source', sources: [] };
	let out = [], installed = null;
	for (let src in order) {
		let r = sh('TS_METADATA_TIMEOUT=10 TS_METADATA_RETRIES=0 ' + sq(libdir() + '/update.sh') + ' list ' + sq(proj) + ' ' + sq(src) + ' rpc 2>/dev/null');
		if (r.rc != 0) continue;
		let data = null;
		try { data = json(r.out); } catch (e) { data = null; }
		if (data == null || data.tags == null || length(data.tags) == 0) continue;
		let bp = td + '/rel-' + src + '-' + proj + '.json';
		let m = sh('stat -c %Y ' + sq(bp) + ' 2>/dev/null');
		let cachedAt = m.rc == 0 ? int(trim(m.out)) || 0 : 0;
		out[length(out)] = { name: src, tags: data.tags, files: data.files || {}, info: data.info || null, check: data.check || null, cached_at: cachedAt };
		if (proj == 'luci-app-tailscale' && installed == null && data.installed_version != null && data.installed_version != '')
			installed = data.installed_version;
	}
	let result = { sources: out };
	if (installed != null) result.installed_version = installed;
	return result;
}

function getVersionFiles(p) {
	let proj = proj_of(p);
	let source = p.source == null ? '' : '' + p.source;
	let version = p.version == null ? '' : '' + p.version;
	if (source == '' || source == 'official' || src_list(source) == null || version == '')
		return { ok: false, error: 'bad_source', files: [] };
	let r = sh('TS_METADATA_TIMEOUT=10 TS_METADATA_RETRIES=0 ' + sq(libdir() + '/update.sh') + ' files ' + sq(proj) + ' ' + sq(source) + ' ' + sq(version) + ' 2>/dev/null');
	if (r.rc != 0) return { ok: false, error: 'no_files', files: [] };
	let data = null;
	try { data = json(r.out); } catch (e) { data = null; }
	if (data == null || data.files == null) return { ok: false, error: 'no_files', files: [] };
	return { ok: true, source: source, version: data.version || version, files: data.files };
}

function refreshSources(p) {
	let td = tmpdir();
	let srcs = src_list(p.source);
	if (srcs == null) return { ok: false, error: 'bad_source' };
	let projs = [];
	if (p.proj == null || p.proj == '')
		projs = ['tailscale', 'luci-app-tailscale'];
	else if (p.proj == 'tailscale' || p.proj == 'luci-app-tailscale')
		projs = [p.proj];
	else
		return { ok: false, error: 'bad_project' };
	for (let src in srcs) {
		for (let proj in projs) {
			try { unlink(td + '/rel-' + src + '-' + proj + '.json'); } catch (e) {}
		}
	}
	return { ok: true };
}

function resolveFile(p) {
	let proj = proj_of(p);
	let td = tmpdir();
	let srcs = src_list(p.source);
	if (srcs == null || (p.source == 'official' && proj != 'tailscale')) return { ok: false, error: 'bad_source' };
	let ver = (p.version == null || p.version == '') ? 'latest' : '' + p.version;
	let want = (p.file == null || p.file == '') ? 'auto' : '' + p.file;
	let arch = (p.arch == null || p.arch == '') ? 'auto' : '' + p.arch;
	for (let src in srcs) {
		sh('TS_METADATA_TIMEOUT=5 TS_METADATA_RETRIES=0 ' + sq(libdir() + '/update.sh') + ' check ' + sq(proj) + ' ' + sq(src) + ' >/dev/null 2>&1');
		let bp = td + '/rel-' + src + '-' + proj + '.json';
		let r = sh(sq(libdir() + '/update.sh') + ' resolve ' + sq(proj) + ' ' + sq(bp) + ' ' + sq(ver) + ' ' + sq(want) + ' ' + sq(arch) + ' 2>/dev/null');
		if (r.rc != 0) continue;
		let file = '';
		for (let ln in split(trim(r.out), '
')) {
			if (trim(ln) != '') { file = trim(ln); break; }
		}
		if (file == '') continue;
		let tag = ver;
		if (ver == 'latest') {
			let vr = sh(sq(libdir() + '/update.sh') + ' list ' + sq(proj) + ' ' + sq(src) + ' tags 2>/dev/null');
			if (vr.rc == 0) {
				let data = null;
				try { data = json(vr.out); } catch (e) { data = null; }
				if (data != null && data.tags != null && length(data.tags) > 0) tag = data.tags[0];
			}
		}
		let uh = sh(sq(libdir() + '/update.sh') + ' url ' + sq(bp) + ' ' + sq(file) + ' 2>/dev/null');
		let url = uh.rc == 0 ? trim(uh.out) : '';
		if (src == 'official')
			return { ok: true, source: src, tag: tag, file: file, native: true };
		if (url == '') continue;
		return { ok: true, source: src, tag: tag, file: file, url: url };
	}
	return { ok: false, error: 'no_match' };
}

function getFileSize(p) {
	let source = p.source == null ? '' : '' + p.source;
	let file = p.file == null || p.file == '' ? 'auto' : '' + p.file;
	if (source == '' || source == 'official' || src_list(source) == null || index(file, '/') >= 0)
		return { ok: false, error: 'bad_file' };
	let r = sh('TS_METADATA_TIMEOUT=10 TS_METADATA_RETRIES=0 ' + sq(libdir() + '/update.sh') + ' size ' + sq(source) + ' ' + sq(file) + ' 2>/dev/null');
	let bytes = r.rc == 0 ? int(trim(r.out)) || 0 : 0;
	if (bytes <= 0) return { ok: false, error: 'no_size' };
	return { ok: true, bytes: bytes };
}

function manual_upload_root() { return '/tmp/tailscale/manual'; }
function manual_upload_lock() { return '/tmp/tailscale/manual-upload.lock'; }
function manual_upload_stage(id) { return manual_upload_root() + '/' + id + '.tailscaled'; }
function manual_upload_backup(id) { return manual_upload_root() + '/' + id + '.tailscaled.old'; }
function manual_upload_meta(id) { return tmpdir() + '/task-' + id + '.manual.json'; }

function manual_upload_status(id, step, percent, error) {
	let msg = '';
	if (error != null) msg = error;
	try { writefile(tmpdir() + '/task-' + id + '.json', sprintf('%J', { step: step, percent: percent, msg: msg, done: false, error: '' })); } catch (e) {}
}

function manual_upload_clear(id) {
	let lock = manual_upload_lock(), owner = '';
	try { owner = trim(readfile(lock + '/id')); } catch (e) {}
	if (owner == id)
		sh('rm -f ' + sq(manual_upload_stage(id)) + ' ' + sq(manual_upload_backup(id)) + ' ' + sq(manual_upload_meta(id)) + ' && rm -rf ' + sq(lock));
	else
		sh('rm -f ' + sq(manual_upload_stage(id)) + ' ' + sq(manual_upload_backup(id)) + ' ' + sq(manual_upload_meta(id)));
}

function beginManualUpload(p) {
	let name = p.name == null ? '' : '' + p.name;
	let size = null;
	try { size = int(p.size); } catch (e) { size = null; }
	if (name != 'tailscaled' || size == null || size < 1 || size > 33554432) return { ok: false, error: 'invalid_upload' };
	let mount = sh("awk '$2 == \"/tmp\" { print $3; exit }' /proc/mounts");
	if (trim(mount.out) != 'tmpfs') return { ok: false, error: 'tmpfs_unavailable' };
	let space = diskSpace('/tmp');
	if (space.free_bytes < size + 1048576) return { ok: false, error: 'memory_low', free_bytes: space.free_bytes, required_bytes: size + 1048576 };
	let root = manual_upload_root(), lock = manual_upload_lock();
	if (sh('mkdir -p ' + sq(root)).rc != 0) return { ok: false, error: 'tmpfs_unavailable' };
	if (sh('mkdir ' + sq(lock) + ' 2>/dev/null').rc != 0) {
		let owner = '';
		try { owner = trim(readfile(lock + '/id')); } catch (e) {}
		let safeOwner = clean_id(owner), now = sh('date +%s 2>/dev/null');
		if (safeOwner == null) {
			let lockStamp = sh('stat -c %Y ' + sq(lock) + ' 2>/dev/null');
			if (lockStamp.rc != 0 || (int(trim(now.out)) || 0) - (int(trim(lockStamp.out)) || 0) > 60) sh('rm -rf ' + sq(lock));
		}
		else {
			let stamp = sh('stat -c %Y ' + sq(manual_upload_stage(safeOwner)) + ' 2>/dev/null');
			if (stamp.rc != 0) {
				let lockStamp = sh('stat -c %Y ' + sq(lock) + ' 2>/dev/null');
				if (lockStamp.rc != 0 || (int(trim(now.out)) || 0) - (int(trim(lockStamp.out)) || 0) > 60) manual_upload_clear(safeOwner);
			}
			else if ((int(trim(now.out)) || 0) - (int(trim(stamp.out)) || 0) > 1800) manual_upload_clear(safeOwner);
		}
		if (sh('mkdir ' + sq(lock) + ' 2>/dev/null').rc != 0) return { ok: false, error: 'busy' };
	}
	let tc = clock(), id = sprintf('m%d%d', tc[0], tc[1]);
	if (sh('mkdir -p ' + sq(tmpdir())).rc != 0) {
		sh('rm -rf ' + sq(lock));
		return { ok: false, error: 'tmpfs_unavailable' };
	}
	if (sh('umask 077; : > ' + sq(manual_upload_stage(id)) + ' && chmod 600 ' + sq(manual_upload_stage(id))).rc != 0) {
		sh('rm -rf ' + sq(lock));
		return { ok: false, error: 'tmpfs_unavailable' };
	}
	try {
		writefile(lock + '/id', id);
		writefile(manual_upload_meta(id), sprintf('%J', { size: size, name: name }));
		writefile(tmpdir() + '/task-' + id + '.proj', 'tailscale');
		writefile(tmpdir() + '/task-' + id + '.log', '');
		manual_upload_status(id, 'upload', 0, '');
	} catch (e) {
		manual_upload_clear(id);
		let currentOwner = '';
		try { currentOwner = trim(readfile(lock + '/id')); } catch (e) {}
		if (currentOwner == '') sh('rm -rf ' + sq(lock));
		return { ok: false, error: 'tmpfs_unavailable' };
	}
	return { ok: true, task_id: id, upload_path: manual_upload_stage(id) };
}

function finishManualUpload(p) {
