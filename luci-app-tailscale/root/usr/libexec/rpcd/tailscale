	let bin = bindir();
	let s = sh(sq(bin + '/tailscale') + ' --socket=' + sq(sockpath()) + ' status --json 2>/dev/null');
	let st = null;
	if (s.rc == 0) {
		try { st = json(s.out); } catch (e) { st = null; }
	}
	let ips = [];
	if (st != null && st.Peer != null) {
		for (let nk, pr in st.Peer) {
			if (pr.Online != true) continue;
			if (length(ips) >= max) break;
			if (pr.TailscaleIPs != null && length(pr.TailscaleIPs) > 0) {
				let pip = pr.TailscaleIPs[0];
				if (pip != null && pip != '') ips[length(ips)] = pip;
			}
		}
	}
	let lat = {};
	for (let ip in ips) {
		let cmd = sq(bin + '/tailscale') + ' --socket=' + sq(sockpath()) + ' ping --timeout=' + tmo + 's -c 1 ' + sq(ip) + ' 2>&1';
		let r = sh(cmd);
		logTailscale(cmd, r.rc, r.out);
		let ms = null, via = '';
		for (let ln in split(r.out, '\n')) {
			let t = trim(ln);
			if (index(t, 'direct connection not established') >= 0) {
				if (via == '') via = 'derp';
				continue;
			}
			if (index(t, 'pong from ') < 0) continue;
			let vi = index(t, ' via ');
			let ini = index(t, ' in ');
			if (vi < 0 || ini < 0 || ini < vi) continue;
			let vs = trim(substr(t, vi + 5, ini - vi - 5));
			if (length(vs) > 6 && substr(vs, 0, 5) == 'DERP(' && substr(vs, length(vs) - 1, 1) == ')')
				via = substr(vs, 5, length(vs) - 6);
			else
				via = 'direct';
			let ds = trim(substr(t, ini + 4, length(t) - ini - 4));
			if (length(ds) >= 2) {
				if (length(ds) >= 3 && substr(ds, length(ds) - 2, 2) == 'ms')
					ms = int(substr(ds, 0, length(ds) - 2)) || 0;
				else if (substr(ds, length(ds) - 1, 1) == 's')
					ms = parse_sec(substr(ds, 0, length(ds) - 1));
			}
		}
		lat[ip] = { ms: ms, via: via };
	}
	try { writefile(tmpdir() + '/ping.json', sprintf('%J', { at: clock()[0], latency: lat })); } catch (e) {}
	return { latency: lat };
}

function serviceAction(p) {
	let act = p.action;
	if (index(['start', 'stop', 'restart', 'enable', 'disable'], act) < 0)
		return { accepted: false, error: 'bad_action' };
	let init = initd();
	if (act == 'enable' || act == 'disable') {
		let r = sh(sq(init) + ' ' + act + ' 2>&1');
		if (r.rc == 0) return { accepted: true };
		return { accepted: false, error: 'action_fail' };
	}
	let lock = op_lock_take();
	if (lock == null)
		return { accepted: false, busy: true };
	if (!op_lock_run(lock, sq(init) + ' ' + act + ' >/dev/null 2>&1')) {
		op_lock_release(lock);
		return { accepted: false, error: 'action_fail' };
	}
	return { accepted: true };
}

function removeCore(p) {
	let lock = op_lock_take(), uploadLock = manual_upload_lock();
	if (lock == null)
		return { ok: false, busy: true, error: 'busy' };
	if (sh('mkdir -p ' + sq(manual_upload_root()) + ' && mkdir ' + sq(uploadLock) + ' 2>/dev/null').rc != 0) {
		op_lock_release(lock);
		return { ok: false, busy: true, error: 'busy' };
	}
	let r = sh('echo $$ > ' + sq(lock + '/pid') + '; ' + sq(libdir() + '/update.sh') + ' remove-core 2>&1');
	sh('rmdir ' + sq(uploadLock) + ' 2>/dev/null');
	op_lock_release(lock);
	let result = trim(r.out);
	if (r.rc == 0 && result == 'removed') return { ok: true };
	return { ok: false, busy: result == 'busy', error: result == '' ? 'delete_fail' : result };
}

function clearLogs(p) {
	let td = tmpdir();
	if (sh('mkdir -p ' + sq(td)).rc != 0)
		return { ok: false, error: 'log_dir' };
	let files = ['daemon.log', 'backend.log', 'backend.log.tmp', 'last-up.log'];
	if (!upPidAlive(td)) files[length(files)] = 'up-url.log';
	for (let name in files) {
		if (sh(': > ' + sq(td + '/' + name)).rc != 0)
			return { ok: false, error: 'log_clear' };
	}
	return { ok: true };
}

function getLogs(p) {
	let n = clean_int(p.lines, 50, 5, 500);
	let bin = bindir(), td = tmpdir();
	let lr = sh('tail -n ' + n + ' ' + sq(td + '/daemon.log') + ' 2>/dev/null');
	let br = sh('tail -n ' + n + ' ' + sq(td + '/backend.log') + ' 2>/dev/null');
	let st = sh(sq(bin + '/tailscale') + ' --socket=' + sq(sockpath()) + ' status 2>&1');
	let vs = sh(sq(bin + '/tailscale') + ' version 2>/dev/null');
	return { logread: lr.out, backend_log: br.out, status: st.out, version: trim(vs.out) };
}

function diag(p) {
	let g = getStatus({ force_refresh: '1' });
	let c = getConfig({});
	let t = '== tailscale diag ==\n';
	t = t + sprintf('binary: %s version: %s running: %s logged_in: %s enabled: %s\n', g.binary_ok ? 'ok' : 'MISSING', g.version, g.running ? 'yes' : 'no', g.logged_in ? 'yes' : 'no', g.enabled ? 'yes' : 'no');
	t = t + 'tail_ips: ' + join(',', g.tail_ips) + '\n';
	t = t + sprintf('hostname: %s tailnet: %s key_expiry: %s uptime: %d rx: %d tx: %d\n', g.hostname, g.tailnet, g.key_expiry, g.uptime, g.rx_bytes, g.tx_bytes);
	for (let pr in g.peers)
		t = t + sprintf('peer %s %s online=%s direct=%s exit=%s approved=%d pending=%d\n', pr.name, pr.ip, pr.online ? 'yes' : 'no', pr.direct ? 'yes' : 'no', pr.exit_active ? 'active' : (pr.exit_option ? 'option' : 'no'), length(pr.approved), length(pr.pending));
	t = t + sprintf('config: %J\n', c.config);
	t = t + sprintf('fw: %s zone=%s iface=%s apply=%J\n', g.fw_driver, g.fw_zone ? 'yes' : 'no', g.fw_iface ? 'yes' : 'no', g.fw_apply);
	let cronf = getenv2('TS_CRON_FILE', '/etc/crontabs/root');
	let cur = '';
	try { cur = readfile(cronf); } catch (e) { cur = ''; }
	if (cur != null) {
		for (let ln in split(cur, '\n')) {
			if (index(ln, 'tailscale-auto') >= 0 || index(ln, 'update.sh --auto') >= 0 || index(ln, 'update.sh auto') >= 0 || index(ln, 'wrapper.sh auto-update') >= 0)
				t = t + 'cron: ' + ln + '\n';
		}
	}
	let rt = sh('ip route show 2>/dev/null');
	let rn = 0;
	for (let ln in split(rt.out, '\n')) {
		if (rn >= 20) break;
		if (trim(ln) != '') {
			t = t + 'route: ' + trim(ln) + '\n';
			rn++;
		}
	}
	return { text: t };
}

const DISPATCH = { getStatus: getStatus, getConfig: getConfig, setConfig: setConfig, getSources: getSources, getVersionFiles: getVersionFiles, refreshSources: refreshSources, resolveFile: resolveFile, getFileSize: getFileSize, download: download, progress: progress, cancelTask: cancelTask, beginManualUpload: beginManualUpload, finishManualUpload: finishManualUpload, applyNetwork: applyNetwork, applyCron: applyCron, getLogin: getLogin, logout: logout, reauth: reauth, applyUp: applyUp, pingPeers: pingPeers, serviceAction: serviceAction, getLogs: getLogs, clearLogs: clearLogs, removeCore: removeCore, diag: diag };

