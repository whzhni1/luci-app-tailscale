function upSpawn(td, force, useAuthKey) {
	let log = td + '/up-url.log', pid = td + '/up.pid', lock = td + '/up-spawn';
	if (sh('mkdir -p ' + sq(td)).rc != 0) return false;
	if (upPidAlive(td)) return true;
	if (sh('mkdir ' + sq(lock) + ' 2>/dev/null').rc != 0)
		return upPidAlive(td) || (sh('test -d ' + sq(lock) + ' 2>/dev/null').rc == 0);
	let started = false;
	if (upPidAlive(td)) {
		started = true;
	}
	else {
		try { unlink(pid); } catch (e) {}
		try { writefile(log, ''); } catch (e) {}
		let cmd = upCommand(force ? true : false, useAuthKey ? true : false) + ' ' + sq('--timeout=' + UP_TIMEOUT + 's');
		if (sh('command -v timeout >/dev/null 2>&1').rc == 0)
			cmd = 'timeout ' + (UP_TIMEOUT + 60) + ' ' + cmd;
		let r = sh(cmd + ' > ' + sq(log) + ' 2>&1 & echo $! > ' + sq(pid));
		started = r.rc == 0;
	}
	sh('rmdir ' + sq(lock) + ' 2>/dev/null');
	return started;
}

function getLogin(p) {
	if (sh('test -x ' + sq(bindir() + '/tailscale') + ' 2>/dev/null').rc != 0)
		return { ok: false, error: 'up_nobin' };
	if (sh('test -S ' + sq(sockpath()) + ' 2>/dev/null').rc != 0)
		return { ok: true, pending: true };
	let statusCmd = sq(bindir() + '/tailscale') + ' --socket=' + sq(sockpath()) + ' status 2>&1';
	let status = sh(statusCmd);
	let url = extractLoginUrl(status.out);
	if (url != '') {
		logTailscale(statusCmd, status.rc, status.out);
		return { ok: true, url: url };
	}
	let td = tmpdir();
	let cmd = upCommand(false) + ' ' + sq('--timeout=' + UP_TIMEOUT + 's');
	if (sh('command -v timeout >/dev/null 2>&1').rc == 0)
		cmd = 'timeout ' + (UP_TIMEOUT + 60) + ' ' + cmd;
	if (!upSpawn(td)) {
		logTailscale(cmd, 'up_spawn', '[backend] Unable to start login command');
		return { ok: false, error: 'up_spawn' };
	}
	let output = upCurrentOutput(td);
	url = extractLoginUrl(output);
	if (url != '') {
		logTailscale(cmd, 'url', output);
		return { ok: true, url: url };
	}
	status = sh(statusCmd);
	url = extractLoginUrl(status.out);
	if (url != '') {
		logTailscale(statusCmd, status.rc, status.out);
		return { ok: true, url: url };
	}
	output = upCurrentOutput(td);
	url = extractLoginUrl(output);
	if (url != '') {
		logTailscale(cmd, 'url', output);
		return { ok: true, url: url };
	}
	if (upPidAlive(td))
		return { ok: true, pending: true };
	if (output == '') output = '[backend] Login command exited without a URL; see ' + td + '/up-url.log';
	logTailscale(cmd, 'up_url', output);
	return { ok: false, error: 'up_url' };
}

